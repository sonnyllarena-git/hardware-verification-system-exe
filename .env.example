# Copy to .env (same folder as the EXE) and fill in real values. Never commit .env.

API_BASE_URL=http://localhost:3001
API_KEY=your-api-key-here

# SUBMIT_MODE=api (default) posts to tcp-hardware-check-api above.
# SUBMIT_MODE=supabase posts straight to Supabase (quick remote testing only, no
# reachable API host required) via the RPC function in scratchpad/direct-submit-rpc.sql.
# Revert to SUBMIT_MODE=api once the API is deployed somewhere reachable.
SUBMIT_MODE=api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
